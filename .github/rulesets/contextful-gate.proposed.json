{
  "name": "Contextful FlareDispatch gate",
  "target": "branch",
  "enforcement": "disabled",
  "conditions": {
    "ref_name": {
      "include": ["refs/heads/main"],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": false,
        "required_status_checks": [
          { "context": "flare-dispatch/contextful-gate" },
          { "context": "flare-dispatch/check:preflight" },
          { "context": "flare-dispatch/check:workspace.compile" },
          { "context": "flare-dispatch/check:workspace.cli-1" },
          { "context": "flare-dispatch/check:workspace.cli-2" },
          { "context": "flare-dispatch/check:workspace.cli-3" },
          { "context": "flare-dispatch/check:workspace.cli-4" },
          { "context": "flare-dispatch/check:workspace.cli-5" },
          { "context": "flare-dispatch/check:workspace.cli-6" },
          { "context": "flare-dispatch/check:workspace.cli-7" },
          { "context": "flare-dispatch/check:workspace.cli-8" },
          { "context": "flare-dispatch/check:suite.cli" },
          { "context": "flare-dispatch/check:suite.foundation" },
          { "context": "flare-dispatch/check:suite.runtime" },
          { "context": "flare-dispatch/check:suite.read" },
          { "context": "flare-dispatch/check:suite.ci" },
          { "context": "flare-dispatch/check:acceptance" },
          { "context": "flare-dispatch/check:perimeter" }
        ]
      }
    }
  ]
}
