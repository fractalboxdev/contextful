{
  "name": "Contextful FlareDispatch gate",
  "target": "branch",
  "enforcement": "disabled",
  "conditions": {
    "ref_name": {
      "include": ["refs/heads/main"],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": false,
        "required_status_checks": [
          { "context": "flare-dispatch/contextful-gate" },
          { "context": "flare-dispatch/check:pins" },
          { "context": "flare-dispatch/check:toolchain" },
          { "context": "flare-dispatch/check:schema" },
          { "context": "flare-dispatch/check:test-first.validate" },
          { "context": "flare-dispatch/check:workspace.compile" },
          { "context": "flare-dispatch/check:workspace.cli-1" },
          { "context": "flare-dispatch/check:workspace.cli-2" },
          { "context": "flare-dispatch/check:workspace.cli-3" },
          { "context": "flare-dispatch/check:workspace.cli-4" },
          { "context": "flare-dispatch/check:workspace.cli-formal" },
          { "context": "flare-dispatch/check:workspace.foundation" },
          { "context": "flare-dispatch/check:workspace.runtime" },
          { "context": "flare-dispatch/check:workspace.read" },
          { "context": "flare-dispatch/check:workspace.ci" },
          { "context": "flare-dispatch/check:acceptance" },
          { "context": "flare-dispatch/check:evaluate.foundation" },
          { "context": "flare-dispatch/check:evaluate.runtime" },
          { "context": "flare-dispatch/check:evaluate.read" },
          { "context": "flare-dispatch/check:evaluate.cli" },
          { "context": "flare-dispatch/check:evaluate.ci" },
          { "context": "flare-dispatch/check:evaluate.probe" },
          { "context": "flare-dispatch/check:features.agent" },
          { "context": "flare-dispatch/check:features.connectors" },
          { "context": "flare-dispatch/check:features.context" },
          { "context": "flare-dispatch/check:features.core" },
          { "context": "flare-dispatch/check:features.decode" },
          { "context": "flare-dispatch/check:features.outbound" },
          { "context": "flare-dispatch/check:features.policy" },
          { "context": "flare-dispatch/check:features.sqlite" },
          { "context": "flare-dispatch/check:features.sync" },
          { "context": "flare-dispatch/check:features.wasm" },
          { "context": "flare-dispatch/check:features.binary-none" },
          { "context": "flare-dispatch/check:features.formal-none" },
          { "context": "flare-dispatch/check:features.binary-all" },
          { "context": "flare-dispatch/check:features.formal-all" },
          { "context": "flare-dispatch/check:features.binary-data-plane" },
          { "context": "flare-dispatch/check:features.formal-data-plane" },
          { "context": "flare-dispatch/check:features.binary-contextful-edge" },
          { "context": "flare-dispatch/check:features.formal-contextful-edge" },
          { "context": "flare-dispatch/check:crate-graph" },
          { "context": "flare-dispatch/check:connectors" },
          { "context": "flare-dispatch/check:surfaces" },
          { "context": "flare-dispatch/check:formal" },
          { "context": "flare-dispatch/check:budget.control" },
          { "context": "flare-dispatch/check:budget.edge" },
          { "context": "flare-dispatch/check:budget.full" }
        ]
      }
    }
  ]
}
