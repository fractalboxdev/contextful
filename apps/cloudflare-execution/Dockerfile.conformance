FROM alpine:3.22
RUN apk add --no-cache ca-certificates \
 && addgroup -S contextful \
 && adduser -S -G contextful contextful \
 && mkdir -p /work \
 && chown contextful:contextful /work
COPY --chmod=0755 contextful contextful-conformance /usr/local/bin/
COPY source.json /etc/contextful-source.json
USER contextful
WORKDIR /work
CMD ["/bin/sleep", "infinity"]
