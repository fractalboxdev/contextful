{
  "name": "@contextful/cloudflare-execution",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types src/worker-configuration.d.ts --config wrangler.example.jsonc --env-interface ContextfulExecutionEnv --include-runtime=false",
    "prepare-image": "node --experimental-strip-types src/prepare-image.ts",
    "attach-report": "node --experimental-strip-types src/attach-report.ts"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261013.1",
    "@types/node": "^22.20.4",
    "typescript": "^6.0.3",
    "wrangler": "^4.150.0"
  }
}
