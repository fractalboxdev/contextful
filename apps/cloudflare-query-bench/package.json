{
  "name": "@contextful/cloudflare-query-bench",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --containers-rollout=none --config wrangler.example.jsonc --outdir ../../.tmp/cloudflare-query-bench-build",
    "types": "wrangler types src/worker-configuration.d.ts --config wrangler.example.jsonc --env-interface QueryBenchEnv --include-runtime=false",
    "fixtures": "node --experimental-strip-types bench/fixtures.ts",
    "measure": "node --experimental-strip-types bench/measure.ts"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261013.1",
    "@types/node": "^22.20.4",
    "typescript": "^6.0.3",
    "wrangler": "^4.150.0"
  }
}
