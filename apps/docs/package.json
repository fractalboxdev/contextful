{
  "name": "@contextful/docs",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev --force",
    "build": "astro build --force && pnpm test && pnpm test:site",
    "preview": "astro preview",
    "check": "pnpm typecheck",
    "typecheck": "node -e \"require('fs').mkdirSync('.astro',{recursive:true})\" && wrangler types .astro/worker-configuration.d.ts && astro check",
    "test": "node --test test/*.test.mjs",
    "test:site": "node --test test/built-site.mjs",
    "deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@fractalboxdev/merlion-rehype": "file:vendor/merlion/fractalboxdev-merlion-rehype-0.2.0.tgz",
    "@fractalboxdev/merlion-themes": "file:vendor/merlion/fractalboxdev-merlion-themes-0.2.0.tgz",
    "@fractalboxdev/merlion-view": "file:vendor/merlion/fractalboxdev-merlion-view-0.2.0.tgz",
    "@fractalboxdev/merlion-wasm": "file:vendor/merlion/fractalboxdev-merlion-wasm-0.2.0.tgz",
    "astro": "^7.3.3",
    "cookie": "^2.0.1",
    "pagefind": "1.5.2",
    "smol-toml": "^1.8.0",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^22.20.4",
    "typescript": "^6.0.3",
    "wrangler": "^4.136.1"
  }
}
