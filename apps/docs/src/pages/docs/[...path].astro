---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import { companions, descriptionOf, titleOf } from "../../lib/nav";
import { collectionRoute, contractsByFile } from "../../lib/corpus.mjs";

type Entry = CollectionEntry<"spec" | "guide" | "cards" | "adr">;
interface Props { entry?: Entry; entries?: Entry[]; collection: string; title?: string; }

export async function getStaticPaths() {
  const sections = [
    { collection: "spec" as const, path: "specs/contracts", title: "Contracts" },
    { collection: "guide" as const, path: "guide", title: "Guides" },
    { collection: "cards" as const, path: "specs/cards", title: "Contract cards" },
    { collection: "adr" as const, path: "specs/adr", title: "Principles and architecture decisions" },
  ];
  const contracts = contractsByFile();
  return (await Promise.all(sections.map(async ({ collection, path, title }) => {
    const entries = (await getCollection(collection)).filter((entry) => entry.id !== "targets")
      .sort((a, b) => a.id.localeCompare(b.id, "en", { numeric: true }));
    return [
      ...(collection === "guide" ? [] : [{ params: { path }, props: { collection, title, entries: collection === "spec" ? entries.filter((entry) => contracts.has(entry.id)) : entries } }]),
      ...entries.map((entry) => ({
        params: { path: collectionRoute(collection, entry.id).replace(/^\/docs\//, "").replace(/\/$/, "") },
        props: { entry, collection },
      })),
    ];
  }))).flat();
}

const { entry, entries, collection, title } = Astro.props;
const rendered = entry ? await render(entry) : undefined;
const Content = rendered?.Content;
const links = entry ? await companions(collection === "spec" ? entry.data.contract : collection === "guide" || collection === "cards" ? entry.id : undefined) : undefined;
---
<Base title={entry ? titleOf(entry) : title!} description={entry ? descriptionOf(entry) : `${title} in the Contextful documentation.`} headings={rendered?.headings}>
  {entry && <p class="eyebrow"><a href="/docs/">Docs</a> / <a href={collection === "guide" ? "/docs/#choose-a-guide" : "/docs/specs/"}>{collection === "guide" ? "Guides" : "Specification"}</a></p>}
  {links && <p class="eyebrow">
    contract <code>{links.contract}</code>
    {links.files.map((file) => <Fragment> · <a href={file.href}>{file.file}</a></Fragment>)}
    {links.guide && <Fragment> · <a href={links.guide}>guide</a></Fragment>}
    {links.card && <Fragment> · <a href={links.card}>card</a></Fragment>}
  </p>}
  {Content && <Content />}
  {entries && <Fragment>
    <h1>{title}</h1>
    <ul class="index-list">{entries.map((item) => <li><a href={collectionRoute(collection, item.id)}>{titleOf(item)}</a></li>)}</ul>
  </Fragment>}
</Base>
