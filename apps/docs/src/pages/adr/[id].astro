---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { descriptionOf, titleOf } from "../../lib/nav";

export async function getStaticPaths() {
  const entries = await getCollection("adr");
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<Base title={titleOf(entry)} description={descriptionOf(entry)} headings={headings}>
  <Content />
</Base>
