---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { companions, descriptionOf, titleOf } from "../../lib/nav";

export async function getStaticPaths() {
  const entries = await getCollection("guide");
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const links = await companions(entry.id);
---

<Base title={titleOf(entry)} description={descriptionOf(entry)} headings={headings}>
  {
    links && (
      <p class="eyebrow">
        guide to contract <code>{links.contract}</code>
        {links.files.map((f) => <> · <a href={f.href}><code>{f.file}</code></a></>)}
        {links.card && <> · <a href={links.card}>card</a></>}
      </p>
    )
  }
  <Content />
</Base>
