---
import type { MarkdownHeading } from "astro";
import { navigation } from "../lib/nav";
import "@fractalboxdev/merlion-themes/merlion-themes.css";
import "@fractalboxdev/merlion-themes/merlion-font.css";
import "../styles/site.css";
import Head from "../components/Head.astro";
import Header from "../components/Header.astro";

interface Props {
  title: string;
  description: string;
  headings?: MarkdownHeading[];
  /** False keeps the page out of the search index. */
  searchable?: boolean;
}

const { title, description, headings = [], searchable = true } = Astro.props;
const groups = await navigation();
const here = Astro.url.pathname;
const toc = headings.filter((h) => h.depth === 2);
const pageTitle = `${title} · Contextful docs`;
---

<!doctype html>
<html lang="en">
  <head>
    <Head title={pageTitle} description={description} />
  </head>
  <body>
    <Header />
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="shell">
      <nav class="sidebar" aria-label="Documentation navigation">
        <div class="section-links">
          <a href="/docs/">Documentation</a>
          <a href="/docs/#choose-a-guide">Guides</a>
          <a href="/docs/specs/">Specification</a>
        </div>
        <details class="sidebar-toggle" id="sidebar-toggle">
          <summary>Contents</summary>
          {
            groups.map((g) => (
              <section>
                {g.collapsed ? (
                  <details open={g.items.some((i) => i.href === here)}>
                    <summary class="group-label">{g.label} ({g.items.length})</summary>
                    <ul>
                      {g.items.map((i) => (
                        <li>
                          <a href={i.href} aria-current={i.href === here ? "page" : undefined}>
                            {i.hint && <span class="hint">{i.hint}</span>}
                            {i.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </details>
                ) : (
                  <>
                    <h2 class="group-label">{g.label}</h2>
                    <ul>
                      {g.items.map((i) => (
                        <li>
                          <a href={i.href} aria-current={i.href === here ? "page" : undefined}>
                            {i.hint && <span class="hint">{i.hint}</span>}
                            {i.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </>
                )}
              </section>
            ))
          }
        </details>
        <script is:inline>
          // Open on wide screens; a phone starts with the contents folded above the page.
          document.getElementById("sidebar-toggle").open = !matchMedia("(max-width: 800px)").matches;
        </script>
      </nav>
      <main class="content" id="main">
        <article class="prose" data-pagefind-body={searchable ? "" : undefined}>
          <slot />
        </article>
      </main>
      {
        toc.length > 0 && (
          <aside class="toc" aria-label="On this page">
            <h2 class="group-label">On this page</h2>
            <ul>
              {toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ul>
          </aside>
        )
      }
    </div>
    <script>
      // <merlion-view> gives each diagram pan, zoom, fullscreen and highlighting; a drag
      // on a label selects its text.
      import "@fractalboxdev/merlion-view";
    </script>
  </body>
</html>
