---
import type { MarkdownHeading } from "astro";
import { navigation } from "../lib/nav";
import "@fractalbox/merlion-themes/merlion-themes.css";
import "@fractalbox/merlion-themes/merlion-font.css";
import "../styles/site.css";

interface Props {
  title: string;
  description: string;
  headings?: MarkdownHeading[];
}

const { title, description, headings = [] } = Astro.props;
const groups = await navigation();
const here = Astro.url.pathname;
const toc = headings.filter((h) => h.depth === 2);
const pageTitle = here === "/" ? title : `${title} · Contextful spec`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
  </head>
  <body>
    <header class="topbar">
      <a class="brand" href="/"><strong>Contextful</strong> <span>spec</span></a>
    </header>
    <div class="shell">
      <nav class="sidebar" aria-label="Spec files">
        <details class="sidebar-toggle" id="sidebar-toggle">
          <summary>Contents</summary>
          {
            groups.map((g) => (
              <section>
                {g.collapsed ? (
                  <details open={g.items.some((i) => i.href === here)}>
                    <summary class="group-label">{g.label} ({g.items.length})</summary>
                    <ul>
                      {g.items.map((i) => (
                        <li>
                          <a href={i.href} aria-current={i.href === here ? "page" : undefined}>
                            {i.hint && <span class="hint">{i.hint}</span>}
                            {i.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </details>
                ) : (
                  <>
                    <h2 class="group-label">{g.label}</h2>
                    <ul>
                      {g.items.map((i) => (
                        <li>
                          <a href={i.href} aria-current={i.href === here ? "page" : undefined}>
                            {i.hint && <span class="hint">{i.hint}</span>}
                            {i.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </>
                )}
              </section>
            ))
          }
        </details>
        <script is:inline>
          // Open on wide screens; a phone starts with the contents folded above the page.
          document.getElementById("sidebar-toggle").open = !matchMedia("(max-width: 800px)").matches;
        </script>
      </nav>
      <main class="content">
        <article class="prose">
          <slot />
        </article>
      </main>
      {
        toc.length > 0 && (
          <aside class="toc" aria-label="On this page">
            <h2 class="group-label">On this page</h2>
            <ul>
              {toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ul>
          </aside>
        )
      }
    </div>
    <script>
      // <merlion-view> gives each diagram pan, zoom, fullscreen and highlighting; a drag
      // on a label selects its text.
      import "@fractalbox/merlion-view";
    </script>
  </body>
</html>
