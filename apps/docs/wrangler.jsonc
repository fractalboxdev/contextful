// The docs site is static: the Worker serves `dist/` through Workers Static Assets
// and runs no script. The Node.js build renders diagrams to inline SVG.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "contextful-docs",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./dist" },
  "routes": [
    { "pattern": "contextful.fractalbox.dev", "custom_domain": true },
    // The former documentation domain redirects to the canonical site.
    { "pattern": "spec.contextful.work", "custom_domain": true, "previews_enabled": true }
  ],
  // Workers Builds runs `wrangler preview` on non-production branches, and that command
  // refuses a configuration without a `previews` block.
  "previews": {},
  // Workers Builds watches `spec/*` and `apps/docs/*`: a commit touching neither builds
  // no preview and no deployment.
}
