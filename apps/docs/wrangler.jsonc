// The Worker redirects the former hostname and serves the static Astro build.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "contextful-docs",
  "compatibility_date": "2026-09-01",
  "main": "src/worker.ts",
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true, "not_found_handling": "404-page" },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "routes": [
    { "pattern": "contextful.fractalbox.dev", "custom_domain": true }
  ],
  // Workers Builds runs `wrangler preview` on non-production branches, and that command
  // refuses a configuration without a `previews` block.
  "previews": {},
  // Workers Builds watches `spec/*` and `apps/docs/*`: a commit touching neither builds
  // no preview and no deployment.
}
