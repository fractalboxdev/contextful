{
  "name": "@contextful/console",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:client": "node scripts/build-client.mjs",
    "test": "node scripts/build-client.mjs && node --experimental-strip-types --test test/*.test.ts",
    "build": "node scripts/build-client.mjs && esbuild src/entry.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/server.js"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "5.2.9",
    "@radix-ui/react-tabs": "1.1.15",
    "@tailwindcss/cli": "4.3.2",
    "@types/node": "22.20.4",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "esbuild": "0.25.12",
    "lucide-react": "1.22.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "recharts": "3.9.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.2",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3"
  }
}
